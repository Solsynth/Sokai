{
  "version": "0.2.0",
  "name": "Sokai",
  "description": "The Solar Network app for KaiOS. The Sekai of Solar Network, S(e)okai.",
  "launch_path": "/index.html",
  "theme_color": "#5e6a9e",
  "icons": {
    "16": "/img/icons/icon16x16.png",
    "48": "/img/icons/icon48x48.png",
    "56": "/img/icons/icon56x56.png",
    "60": "/img/icons/icon60x60.png",
    "84": "/img/icons/icon84x84.png",
    "112": "/img/icons/icon112x112.png",
    "128": "/img/icons/icon128x128.png"
  },
  "developer": {
    "name": "Solsynth",
    "url": "https://solsynth.dev"
  },
  "type": "privileged",
  "permissions": {
    "systemXHR": {
      "description": "Required to load remote content"
    },
    "audio-capture": {
      "description": "Required to record voice messages in the app"
    },
    "speech-recognition": {
      "description": "Required to dictate messages with the platform's speech service"
    }
  },
  "installs_allowed_from": [
    "*"
  ],
  "locales": {
    "es": {
      "name": "Sokai",
      "description": "La aplicación de Solar Network para KaiOS.",
      "permissions": {
        "systemXHR": {
          "description": "Necesario para cargar contenido remoto"
        },
        "audio-capture": {
          "description": "Necesario para grabar mensajes de voz en la aplicación"
        },
        "speech-recognition": {
          "description": "Necesario para dictar mensajes con el servicio de voz del sistema"
        }
      }
    }
  },
  "default_locale": "en"
}
